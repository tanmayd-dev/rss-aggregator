// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Feed {
  id           String       @id @default(uuid())
  name         String
  ttl          Int          @default(15)
  lastFetched  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sources      FeedSource[]
  items        FeedItem[]
}

model FeedSource {
  id                  String     @id @default(uuid())
  feedId              String
  feed                Feed       @relation(fields: [feedId], references: [id], onDelete: Cascade)
  url                 String
  type                String     // 'rss' | 'html' | 'reddit' | 'youtube' | 'fourchan'
  resolvedUrl         String?
  config              String?    // JSON string for source-specific config
  lastFetched         DateTime?  // last successful fetch
  nextRefreshAt       DateTime?  // scheduled slot; null until first rebalance
  lastAttemptAt       DateTime?  // last attempt, success or failure
  consecutiveFailures Int        @default(0)
  lastError           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  items               FeedItem[]

  @@index([nextRefreshAt])
}

model FeedItem {
  id            String      @id @default(uuid())
  feedId        String
  feed          Feed        @relation(fields: [feedId], references: [id], onDelete: Cascade)
  sourceId      String?
  source        FeedSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title         String
  link          String
  description   String?
  pubDate       DateTime?
  guid          String?
  extraMetadata String?     // JSON string containing other metadata
  read          Boolean     @default(false)  // read/unread state for the reader UI
  createdAt     DateTime    @default(now())

  @@unique([feedId, link])
}

// One row per refresh tick (cron every 5 minutes). The newest row decides the next
// tick's adaptive budget; older rows feed the activity graph. Pruned after 7 days.
model RefreshRun {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  budget     Int       @default(0)
  due        Int       @default(0)
  attempted  Int       @default(0)
  succeeded  Int       @default(0)
  failed     Int       @default(0)
  durationMs Int?
}
